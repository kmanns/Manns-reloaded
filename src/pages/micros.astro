---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getMicros, isoDate } from '@utils/records'

const micros = await getMicros()
const tags = [...new Set(micros.flatMap(m => m.data.tags ?? []))]
const rendered = await Promise.all(
  micros.map(async m => ({ m, Content: (await m.render()).Content })),
)
---
<BaseLayout title="Micro Posts" description="Quick thoughts, observations, and snippets from daily life.">
  <section class="masthead" data-section="masthead" data-intent="orient" data-layout="band">
    <div class="wrap">
      <h1>Anti-Social Media</h1>
      <p class="lede">Quick thoughts, observations, and snippets from daily life.</p>
      <p class="count label">{micros.length} {micros.length === 1 ? 'entry' : 'entries'}</p>
    </div>
  </section>
  <section class="log" data-section="log" data-intent="browse" data-layout="teletype" aria-label="Micro posts">
    <div class="wrap">
      {tags.length > 0 && (
        <div class="filter-row" role="group" aria-label="Filter by tag" hidden>
          <span class="label">Filter</span>
          <button type="button" class="chip filter-chip" aria-pressed="true" data-tag="">All</button>
          {tags.map(t => <button type="button" class="chip filter-chip" aria-pressed="false" data-tag={t}>#{t}</button>)}
        </div>
      )}
      {micros.length === 0 && <p>No micro posts yet.</p>}
      <ol class="micro-list">
        {rendered.map(({ m, Content }) => (
          <li class="micro" id={`micro-${m.slug}`} data-tags={(m.data.tags ?? []).join(' ')}>
            <time datetime={isoDate(m.data.date)}>{isoDate(m.data.date)}</time>
            <div>
              <div class="micro-body"><Content /></div>
              {m.data.tags && m.data.tags.length > 0 && <p class="tags">{m.data.tags.map(t => <span>#{t}</span>)}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<script>
  // Tag filter: progressive. Without JS the row stays hidden and every entry shows.
  const row = document.querySelector<HTMLElement>('.filter-row')
  if (row) {
    const chips = row.querySelectorAll<HTMLButtonElement>('.filter-chip')
    const items = document.querySelectorAll<HTMLElement>('.micro')
    row.hidden = false
    row.addEventListener('click', e => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.filter-chip')
      if (!b) return
      const tag = b.dataset.tag ?? ''
      for (const c of chips) c.setAttribute('aria-pressed', String(c === b))
      for (const li of items) li.hidden = !!tag && !(li.dataset.tags ?? '').split(' ').includes(tag)
    })
  }
</script>
