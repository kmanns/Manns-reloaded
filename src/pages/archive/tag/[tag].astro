---
import ArchiveRegister from '@components/manns/ArchiveRegister.astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getTagList } from '@utils/content-utils'

export async function getStaticPaths() {
  const tags = await getTagList()
  return tags.map(tag => ({ params: { tag: tag.name } }))
}

const tag = Astro.params.tag as string
---
<BaseLayout title={`Archive · #${tag}`} description={`Posts tagged ${tag}.`}>
  <ArchiveRegister tag={tag} />
</BaseLayout>
