---
import ArchiveRegister from '@components/manns/ArchiveRegister.astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCategoryList } from '@utils/content-utils'

export async function getStaticPaths() {
  const categories = await getCategoryList()
  return categories.map(category => ({ params: { category: category.name } }))
}

const category = Astro.params.category as string
---
<BaseLayout title={`Archive · ${category}`} description={`Posts filed under ${category}.`}>
  <ArchiveRegister category={category} />
</BaseLayout>
