---
import { getCollection } from 'astro:content'
import { licenseConfig, profileConfig, siteConfig } from '@/config'
import CoverImage from '@components/manns/CoverImage.astro'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getRecords } from '@utils/records'
import { url, getCategoryUrl, getDir } from '@utils/url-utils'

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await entry.render()
const records = await getRecords()
const i = records.findIndex(r => r.slug === entry.slug)
const record = records[i]
const previous = records[i + 1]
const next = records[i - 1]
const sections = headings.filter(h => h.depth === 2)
const hasContents = sections.length >= 2

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description || entry.data.title,
  keywords: entry.data.tags,
  author: { '@type': 'Person', name: profileConfig.name, url: Astro.site },
  datePublished: record?.filed,
  inLanguage: (entry.data.lang || siteConfig.lang).replace('_', '-'),
}
---
<BaseLayout title={entry.data.title} description={entry.data.description} article>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class:list={['wrap', { 'has-contents': hasContents }]} data-pagefind-body>
    <section class="record" data-section="record-header" data-intent="orient" data-layout="records-row" aria-labelledby="post-title">
      <dl class="record-row" data-pagefind-ignore>
        <div><dt class="label">No.</dt><dd>{record?.no ?? '—'}</dd></div>
        <div><dt class="label">Filed</dt><dd><time datetime={record?.filed}>{record?.filed}</time></dd></div>
        {entry.data.category && (
          <div><dt class="label">Department</dt><dd><a href={getCategoryUrl(entry.data.category)}>{entry.data.category}</a></dd></div>
        )}
        <div><dt class="label">Length</dt><dd>{remarkPluginFrontmatter.words} words</dd></div>
      </dl>
      <h1 id="post-title" class="post-title" data-pagefind-meta="title">{entry.data.title}</h1>
      {entry.data.description && <p class="standfirst">{entry.data.description}</p>}
      {entry.data.tags.length > 0 && (
        <ul class="chips post-tags" aria-label="Tags" data-pagefind-ignore>
          {entry.data.tags.map(tag => <li><a class="chip" href={url(`/archive/tag/${tag}/`)}>{tag}</a></li>)}
        </ul>
      )}
      {entry.data.image && (
        <CoverImage src={entry.data.image} basePath={`content/posts/${getDir(entry.id)}`} alt={`Cover image for ${entry.data.title}`} />
      )}
    </section>

    <div class="post-grid">
      <article class="prose" data-section="reading" data-intent="read" data-layout="column-68ch" aria-labelledby="post-title">
        <Content />
      </article>
      {hasContents && (
        <nav class="contents" aria-labelledby="contents-title" data-pagefind-ignore>
          <p id="contents-title" class="label">Contents</p>
          <ol>{sections.map(h => <li><a href={`#${h.slug}`}>{h.text.replace(/#$/, '')}</a></li>)}</ol>
        </nav>
      )}
    </div>

    <section class="record-footer" data-section="record-footer" data-intent="navigate" data-layout="ruled-rows" aria-label="Record details" data-pagefind-ignore>
      <dl class="fields">
        <div class="field"><dt class="label">Author</dt><dd>{profileConfig.name}</dd></div>
        <div class="field"><dt class="label">Filed</dt><dd class="mono">{record?.filed}</dd></div>
        {licenseConfig.enable && (
          <div class="field"><dt class="label">License</dt><dd><a href={licenseConfig.url}>{licenseConfig.name}</a></dd></div>
        )}
      </dl>
      {(previous || next) && (
        <ul class="neighbours" aria-label="More records">
          {previous && (
            <li class="entry neighbour"><span class="label">Previous</span><span class="no mono">No. {previous.no}</span><a href={previous.url}>{previous.title}</a></li>
          )}
          {next && (
            <li class="entry neighbour"><span class="label">Next</span><span class="no mono">No. {next.no}</span><a href={next.url}>{next.title}</a></li>
          )}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
