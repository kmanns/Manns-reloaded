---
import { url } from '@utils/url-utils'

const pagefindUrl = url('/pagefind/pagefind.js')
---
<dialog class="search-dialog" aria-label="Search the site" data-pagefind={pagefindUrl}>
  <form method="dialog" role="search">
    <svg class="search-glyph" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
    <label for="search-input" class="visually-hidden">Search posts</label>
    <input id="search-input" type="search" placeholder="Search posts" autocomplete="off">
    <button class="icon-btn close" value="close" aria-label="Close search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </form>
  <p class="search-status" role="status" aria-live="polite"></p>
  <ul class="search-results"></ul>
</dialog>

<script>
  // Pagefind search in a native dialog. The index exists only in the built site
  // (`pnpm build` runs pagefind), so `pnpm dev` says so instead of searching.
  type Pagefind = {
    search: (q: string) => Promise<{
      results: { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> }[]
    }>
  }
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')
  const input = dialog?.querySelector<HTMLInputElement>('input')
  const list = dialog?.querySelector<HTMLUListElement>('.search-results')
  const status = dialog?.querySelector<HTMLParagraphElement>('.search-status')
  let pagefind: Pagefind | null = null
  let run = 0

  async function load() {
    if (pagefind || !dialog) return pagefind
    try {
      pagefind = await import(/* @vite-ignore */ dialog.dataset.pagefind as string)
    } catch {
      if (status) status.textContent = 'Search is available on the built site (pnpm build, then pnpm preview).'
    }
    return pagefind
  }

  async function search(q: string) {
    const id = ++run
    if (!list || !status) return
    if (!q.trim()) {
      list.textContent = ''
      status.textContent = ''
      return
    }
    const pf = await load()
    if (!pf || id !== run) return
    const { results } = await pf.search(q)
    const data = await Promise.all(results.slice(0, 8).map(r => r.data()))
    if (id !== run) return
    list.textContent = ''
    status.textContent = data.length ? `${data.length} result${data.length === 1 ? '' : 's'}` : 'No records found.'
    for (const item of data) {
      const li = document.createElement('li')
      const a = document.createElement('a')
      a.href = item.url
      const title = document.createElement('span')
      title.className = 'title'
      title.textContent = item.meta.title ?? item.url
      const excerpt = document.createElement('span')
      excerpt.className = 'excerpt'
      excerpt.innerHTML = item.excerpt // Pagefind escapes the text and adds <mark> highlights
      a.append(title, excerpt)
      li.append(a)
      list.append(li)
    }
  }

  document.querySelector('.search-open')?.addEventListener('click', () => {
    dialog?.showModal()
    input?.focus()
    load()
  })
  input?.addEventListener('input', () => search(input.value))
  // In a search field the first Escape only clears the text; close the dialog on the first press.
  input?.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      e.preventDefault()
      dialog?.close()
    }
  })
  dialog?.addEventListener('click', e => {
    if (e.target === dialog) dialog.close()
  })
</script>
