---
import { mannsConfig } from '@/config'
import { url, pathsEqual } from '@utils/url-utils'

const here = Astro.url.pathname
const isCurrent = (link: string) =>
  link === '/' ? pathsEqual(here, url('/')) : here.startsWith(url(link))
const [mark, ...rest] = mannsConfig.company.split(' ')
---
<header class="site-header" data-section="header" data-intent="navigate" data-layout="bar">
  <div class="wrap">
    <a class="lockup" href={url('/')} aria-label={`${mannsConfig.company}, home`}>
      <span class="striped" aria-hidden="true">{mark}</span>
      <span class="label" aria-hidden="true">{rest.join(' ')}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {mannsConfig.nav.map(link => (
          <li><a href={url(link.url)} aria-current={isCurrent(link.url) ? 'page' : undefined}>{link.name}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button class="icon-btn search-open" type="button" aria-label="Search" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      </button>
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark mode">
        <svg class="theme-icon-light" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme toggle: flips between light and dark and remembers the choice.
  const root = document.documentElement
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle')
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches
  const label = () =>
    btn?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode')
  label()
  btn?.addEventListener('click', () => {
    root.dataset.theme = isDark() ? 'light' : 'dark'
    label()
    try {
      localStorage.setItem('mns-theme', root.dataset.theme)
    } catch {}
  })
</script>
